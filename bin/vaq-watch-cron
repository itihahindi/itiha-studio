#!/usr/bin/env bash
# Unattended poll, meant for cron/launchd. Not for interactive use — run
# `bin/vaq-watch poll` directly for that.
#
#   */20 * * * * /full/path/to/bin/vaq-watch-cron
#
# cron gives you no cwd, no PATH and no shell profile, so everything here is
# absolute. Output appends to .watch/poll.log.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
LOG="$ROOT/.watch/poll.log"
LOCK="$ROOT/.watch/poll.lock"

mkdir -p "$ROOT/.watch"

# macOS ships no flock, so the lock is an atomic mkdir. A poll takes ~3
# minutes; without this a slow run and the next tick would both drive the
# browser and race the post store.
if ! mkdir "$LOCK" 2>/dev/null; then
  # Stale lock from a killed run: reclaim anything older than 30 minutes.
  if [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +30 2>/dev/null)" ]]; then
    echo "$(date '+%F %T') reclaiming stale lock" >> "$LOG"
    rmdir "$LOCK" 2>/dev/null || true
    mkdir "$LOCK" 2>/dev/null || exit 0
  else
    exit 0   # a poll is already running; skip this tick quietly
  fi
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

{
  echo "── $(date '+%F %T') poll ──"
  "$ROOT/bin/vaq-watch" poll 2>&1
} >> "$LOG"

# Keep the log from growing without bound.
if [[ -f "$LOG" ]] && [[ $(wc -c < "$LOG") -gt 2000000 ]]; then
  tail -c 500000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
