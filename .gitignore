# Secrets (NEVER commit)
.env
.env.local
.env.*.local

# Personal local context (not committed)
CLAUDE.local.md

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Rendered output (large PNGs)
designs/*/output/

# Editor / OS cruft
.DS_Store
.vscode/
.idea/
*.swp

# Optional Claude API source registry (regenerated locally)
sources.json

# Logs
*.log

# bin/kavi daemon state (bin/itiha is a back-compat alias)
.kavi-studio.pid
.itiha-studio.pid

# Handle-watcher state — contains the X session token (x-session.json).
# NEVER commit: this is a live credential.
.watch/

# Source video for reels. 300MB+ and growing; no mp4 has ever been tracked and
# large blobs cannot be removed from history without a rewrite.
designs/*/images/*.mp4
designs/*/images/*.mov
